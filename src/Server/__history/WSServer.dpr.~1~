program WSServer;

{$APPTYPE CONSOLE}

uses
  System.SysUtils,
  System.Classes,
  System.JSON,
  System.Generics.Collections,
  IdContext,
  IdTCPServer,
  IdGlobal,
  IdSocketHandle,
  SimpleWebSocket in '..\Common\SimpleWebSocket.pas';

type
  TClientContext = class
  public
    ID: String;
    WebSocketactive: Boolean;
    UserName: String;
  end;

  TWSServer = class
  private
    FServer: TIdTCPServer;
    FClients: TThreadList<TClientContext>;
    procedure OnConnect(AContext: TIdContext);
    procedure OnDisconnect(AContext: TIdContext);
    procedure OnExecute(AContext: TIdContext);
    procedure Broadcast(const AMessage: String; const AExcludeID: String = '');
    procedure SendTo(const AMessage, ATargetID: String);
  public
    constructor Create;
    destructor Destroy; override;
    procedure Start;
    procedure Stop;
  end;

var
  Server: TWSServer;

{ TWSServer }

constructor TWSServer.Create;
begin
  FClients := TThreadList<TClientContext>.Create;
  FServer := TIdTCPServer.Create(nil);
  FServer.DefaultPort := 8080;
  FServer.OnConnect := OnConnect;
  FServer.OnDisconnect := OnDisconnect;
  FServer.OnExecute := OnExecute;
end;

destructor TWSServer.Destroy;
begin
  FServer.Free;
  FClients.Free;
  inherited;
end;

procedure TWSServer.Start;
begin
  FServer.Active := True;
  Writeln('Server listening on port 8080...');
end;

procedure TWSServer.Stop;
begin
  FServer.Active := False;
  Writeln('Server stopped.');
end;

procedure TWSServer.OnConnect(AContext: TIdContext);
var
  Ctx: TClientContext;
begin
  Ctx := TClientContext.Create;
  Ctx.ID := CreateClassID; // Generate GUID-like ID
  Ctx.WebSocketActive := False;
  AContext.Data := Ctx;
  FClients.Add(Ctx);
  Writeln('Client connected: ' + Ctx.ID);
end;

procedure TWSServer.OnDisconnect(AContext: TIdContext);
var
  Ctx: TClientContext;
begin
  Ctx := TClientContext(AContext.Data);
  if Assigned(Ctx) then
  begin
    Writeln('Client disconnected: ' + Ctx.ID);
    FClients.Remove(Ctx);
    Ctx.Free;
    AContext.Data := nil;
  end;
end;

procedure TWSServer.OnExecute(AContext: TIdContext);
var
  Ctx: TClientContext;
  Key: String;
  Frame: TWebSocketFrame;
  Msg: String;
  Json: TJSONObject;
  Target: String;
begin
  Ctx := TClientContext(AContext.Data);

  // 1. Handshake
  if not Ctx.WebSocketActive then
  begin
    if TSimpleWebSocket.IsWebSocketRequest(AContext, Key) then
    begin
      TSimpleWebSocket.PerformHandshake(AContext, Key);
      Ctx.WebSocketActive := True;
      Writeln('Handshake successful for ' + Ctx.ID);
      // Send Welcome Message with ID
      TSimpleWebSocket.WriteFrame(AContext.Connection.IOHandler, '{"type": "welcome", "id": "' + Ctx.ID + '"}');
    end
    else
    begin
      // Not a websocket request? Maybe just close or ignore
      // For now, let's just disconnect if it sends garbage
      AContext.Connection.Disconnect;
    end;
    Exit;
  end;

  // 2. Read Frames
  if TSimpleWebSocket.ReadFrame(AContext.Connection.IOHandler, Frame) then
  begin
    if Frame.OpCode = 8 then // Close
    begin
      AContext.Connection.Disconnect;
      Exit;
    end;

    if Frame.OpCode = 1 then // Text
    begin
      Msg := Copy(BytesToString(Frame.Payload, IndyTextEncoding_UTF8), 1, Length(Frame.Payload));
      Writeln('Received from ' + Ctx.ID + ': ' + Msg);

      // Parse JSON Protocol
      // Format: { "to": "TARGET_ID" | "ALL", "msg": "TEXT" }
      try
        Json := TJSONObject.ParseJSONValue(Msg) as TJSONObject;
        if Assigned(Json) then
        begin
          try
            Target := Json.GetValue('to').Value;
            if (Target = 'ALL') or (Target = '') then
            begin
              Broadcast(Msg, Ctx.ID); 
            end
            else
            begin
              SendTo(Msg, Target);
            end;
          finally
            Json.Free;
          end;
        end
        else
        begin
             // Not JSON? Just broadcast
             Broadcast(Msg, Ctx.ID);
        end;
      except
        on E: Exception do
          Writeln('Error parsing message: ' + E.Message);
      end;
    end;
  end;
end;

procedure TWSServer.Broadcast(const AMessage: String; const AExcludeID: String);
var
  List: TList<TClientContext>;
  Ctx: TClientContext;
  ContextList: TList<TIdContext>;
  I: Integer;
begin
  ContextList := FServer.Contexts.LockList;
  try
    for I := 0 to ContextList.Count - 1 do
    begin
      Ctx := TClientContext(TIdContext(ContextList[I]).Data);
      if (Ctx <> nil) and Ctx.WebSocketActive and (Ctx.ID <> AExcludeID) then
      begin
        try
          TSimpleWebSocket.WriteFrame(TIdContext(ContextList[I]).Connection.IOHandler, AMessage);
        except
          // Ignore errors sending to specific client
        end;
      end;
    end;
  finally
    FServer.Contexts.UnlockList;
  end;
end;

procedure TWSServer.SendTo(const AMessage, ATargetID: String);
var
  ContextList: TList<TIdContext>;
  I: Integer;
  Ctx: TClientContext;
begin
  ContextList := FServer.Contexts.LockList;
  try
    for I := 0 to ContextList.Count - 1 do
    begin
      Ctx := TClientContext(TIdContext(ContextList[I]).Data);
      if (Ctx <> nil) and (Ctx.ID = ATargetID) and Ctx.WebSocketActive then
      begin
        try
          TSimpleWebSocket.WriteFrame(TIdContext(ContextList[I]).Connection.IOHandler, AMessage);
        except
        end;
        Break; // Found
      end;
    end;
  finally
    FServer.Contexts.UnlockList;
  end;
end;

begin
  try
    Server := TWSServer.Create;
    try
      Server.Start;
      Writeln('Press ENTER to quit.');
      Readln;
      Server.Stop;
    finally
      Server.Free;
    end;
  except
    on E: Exception do
      Writeln(E.ClassName, ': ', E.Message);
  end;
end.
